#
# Dependency update layer for the canonical Spark image (protomotions:spark).
# The base image predates the July 2026 upstream sync; the merged GPC/PEFT
# agent stack additionally needs tensordict (core to the new agents), wandb,
# and cloudpickle. pytest is included for running the repo test suite.
#
# Rebuild in place (from the repo root):
#   docker build -f Dockerfile.spark -t protomotions:spark .
# Run with the existing launcher:
#   ../run_protomotions.sh
FROM protomotions:spark

# wandb is pinned: unpinned resolution picks 0.15.x on aarch64, which is
# incompatible with the image's NumPy 2 (matches requirements_isaaclab.txt).
RUN /isaac-sim/python.sh -m pip install --no-cache-dir \
    tensordict \
    "wandb==0.23.0" \
    cloudpickle \
    pytest

# The image's torch was upgraded past the Isaac ml_archive prebundle, whose
# torchvision/torchaudio were compiled against the original torch and now
# fail on import ("operator torchvision::nms does not exist"), which crashes
# lightning's optional-dependency probes. Neither is needed; hide them so
# imports fall through to "not installed".
RUN cd /isaac-sim/exts/omni.isaac.ml_archive/pip_prebundle && \
    for pkg in torchvision torchaudio; do \
        [ -d "$pkg" ] && mv "$pkg" "$pkg.disabled" || true; \
        for d in "$pkg"-*.dist-info; do [ -d "$d" ] && mv "$d" "$d.disabled" || true; done; \
    done
