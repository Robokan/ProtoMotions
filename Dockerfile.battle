#
# IsaacLab image with ProtoMotions Python dependencies pre-installed, so
# training/viewer containers start without a per-container pip install.
#
# Build (from the repo root):
#   docker build -f Dockerfile.battle -t protomotions:battle .
# Run:
#   scripts/start_battle_container.sh
FROM nvcr.io/nvidia/isaac-lab:2.3.0

# The IsaacLab launcher resolves the bundled Isaac Sim python.
# requirements_isaaclab.txt pins conflict with the image's pinned packages,
# so install the (unpinned) subset ProtoMotions actually imports at runtime.
RUN /workspace/isaaclab/isaaclab.sh -p -m pip install --no-cache-dir \
    dm_control \
    easydict \
    scikit-image \
    tensordict \
    lightning \
    wandb \
    typer \
    rich \
    moviepy \
    pytest \
    huggingface_hub

ENV PYTHONPATH=/workspace/sparkpack/ProtoMotions \
    ACCEPT_EULA=Y \
    PRIVACY_CONSENT=Y \
    OMNI_KIT_ACCEPT_EULA=YES

WORKDIR /workspace/sparkpack/ProtoMotions
ENTRYPOINT ["bash"]
